# ==============================================================================
# PatchLine — AI & Storage Service (FastAPI) Environment Configuration
# ==============================================================================

# ── 1. Server & Networking ──
PORT=5002
ENVIRONMENT=development
# Comma-separated allowlist of origins (NO trailing slashes, NO wildcards in production).
# In production (Render), set to your exact Vercel frontend domain:
# CORS_ORIGINS=https://patchline-ai-omega.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 2. RS256 JWT Authentication & Security ──
# Must be byte-for-byte identical to the public key configured in services/auth_services/.env
# and services/main_services/.env. This service verifies tokens LOCALLY with no network hop.
JWT_PUBLIC_KEY_
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchline
# Optional: during key rotation, keep old public key here during handover window:
# JWT_PREVIOUS_PUBLIC_KEY_BASE64=

# Shared secret for internal gateway communication (must match services/main_services/.env)
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# ── 3. AI Router Configuration (Featherless + Fallback) ──
# See app/services/model_router.py and docs/AI-routing.md
# When FEATHERLESS_ENABLED=true and API key is provided, Featherless handles primary tasks.
FEATHERLESS_ENABLED=false
FEATHERLESS_API_KEY=your_featherless_api_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_TIMEOUT_SECONDS=60

# Per-task Featherless models (must be valid Hugging Face repo IDs on Featherless)
FEATHERLESS_MODEL_ANALYSIS=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_MODEL_FIX=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_MODEL_VERIFY=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
FEATHERLESS_MODEL_RAG_RANKING=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct

# Fallback provider: 'openai' or 'azure_openai' or 'mock'
FALLBACK_PROVIDER=openai
FALLBACK_MODEL_ANALYSIS=gpt-4.1-mini
FALLBACK_MODEL_FIX=gpt-5.2
FALLBACK_MODEL_VERIFY=gpt-5.3-codex
FALLBACK_MODEL_RAG_RANKING=gpt-5.2

# ── 4. Primary / Fallback AI Provider Settings ──
# Option A: Standard OpenAI
AI_PROVIDER=openai
AI_API_KEY=sk-...

# Option B: Azure AI Foundry (if AI_PROVIDER=azure_openai or FALLBACK_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_SCAN=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_FIX=gpt-5.2
AZURE_OPENAI_DEPLOYMENT_VERIFY=gpt-5.3-codex

# ── 5. Databases & Storage ──
# MongoDB: Isolated database for scan findings and history
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_storage_db

# Redis: Real-time scan progress checkpoints and rate-limiting
REDIS_URL=redis://localhost:6379

# Azure Blob Storage (or mock/placeholder if using local disk uploads)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=scan

# ── 6. RAG Memory & Vector Store (Chroma Cloud) ──
# Leave RAG_MEMORY_ENABLED=false to use zero-cost mock embeddings without external dependencies.
RAG_MEMORY_ENABLED=false
EMBEDDING_PROVIDER=mock
# When enabled with Chroma Cloud:
# RAG_MEMORY_ENABLED=true
# EMBEDDING_PROVIDER=azure_openai
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# CHROMA_API_KEY=ck-...
# CHROMA_TENANT=
# CHROMA_DATABASE=
# CHROMA_COLLECTION=finding_memory

# ── 7. SAST Scanning Engine (Semgrep) ──
# Bundled AST-based engine using local rules at semgrep-rules/patchline-rules.yml
SEMGREP_ENABLED=true
SEMGREP_BINARY=semgrep
SEMGREP_CONFIG_PATH=semgrep-rules/patchline-rules.yml
SEMGREP_TIMEOUT_SECONDS=60
SEMGREP_MAX_TARGET_BYTES=2000000

# ── 8. Elasticsearch (Optional — Search Bar & Full-Text) ──
# If omitted, search automatically falls back to MongoDB regex scanning.
# ES_ENDPOINT=http://localhost:9200
# ES_URL=http://localhost:9200
# ES_API_KEY=
# ES_USERNAME=elastic
# ES_PASSWORD=changeme
