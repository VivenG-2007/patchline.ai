# auth-service Environment Variables Example
PORT=5000

NODE_ENV=development
SERVICE_NAME=auth-service
CORS_ORIGINS=http://localhost:3000
# Comma-separated allow-list. Also this service's CSRF defense (no separate
# CSRF token — see docs/security.md), so '*' is rejected outright in
# production (NODE_ENV=production): list explicit origins there.

# ── JWT signing/verification (RS256) ──
# auth-service is the only service that needs the PRIVATE key (it signs
# tokens); main-service, ai-storage-service, and the frontend's edge
# middleware only ever need the PUBLIC key. auth-service also needs its own
# copy of the public key for the /api/auth/verify convenience endpoint.
# Generate both with: npm run generate-keys (from services/auth_services)
JWT_PRIVATE_KEY_BASE64=your_jwt_private_key_base64_encoded
JWT_PUBLIC_KEY_BASE64=your_jwt_public_key_base64_encoded

# MUST be identical across auth-service, main-service, ai-storage-service,
# and frontend/.env.local (middleware.ts) — a mismatch on ANY of these four
# makes every token this service issues look invalid everywhere else,
# usually surfacing as "Invalid or expired token" on the very first API call
# after login.
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchline

# How long an access_token / refresh_token cookie stays valid. Short access
# tokens + a longer refresh token is the point of the rotation flow in
# authController.js — main-service's axios interceptor (frontend/lib/api.ts)
# and the Next.js edge middleware (frontend/middleware.ts) both silently
# refresh on expiry, so raising these is a UX/security tradeoff, not a bug
# workaround.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Identifies which key pair a token was signed with (see jwksRoutes.js).
# Only matters once you rotate keys; fine to leave as the default otherwise.
JWT_KID=key-1

# Key rotation (optional): when you rotate JWT_PRIVATE_KEY_BASE64/JWT_PUBLIC_KEY_BASE64
# to a new pair, move the OLD public key + kid here first instead of just
# deleting them. All three services verify against the current key, then fall
# back to these during the handover window — so outstanding tokens signed
# under the old key (up to JWT_REFRESH_EXPIRES_IN old) still work instead of
# instantly logging everyone out. Once that window has fully elapsed, remove
# these two vars again.
# JWT_PREVIOUS_PUBLIC_KEY_BASE64=
# JWT_PREVIOUS_KID=key-1

# Database
MONGODB_URI=mongodb://localhost:27017/hackathon_platform
MONGODB_DATABASE=auth_db

# Backs the Redis-backed rate limiter (middleware/rateLimiter.js). Required —
# the service now pings this at startup and refuses to boot if it's
# unreachable, same as MONGODB_URI above. Must point at the same Redis
# instance main-service and ai-storage-service use if you want a single
# shared rate-limit budget; a dedicated instance is also fine, it just means
# each service's limits are tracked independently.
REDIS_URL=redis://localhost:6379

# ── Cookies & Domain ──
# COOKIE_DOMAIN: leave unset for local dev (defaults to a host-only cookie,
# which browsers share across ports on the same host — e.g. localhost:3000
# and localhost:5001). Set to your real domain (e.g. ".yourapp.com") in
# production so the cookie is sent to every subdomain-hosted service.
COOKIE_DOMAIN=localhost
# COOKIE_SECURE/COOKIE_SAMESITE only take effect when NODE_ENV=production
# (see cookieOptions() in authController.js — dev always uses secure:false,
# sameSite:'lax' regardless of these). In production, secure=true requires
# HTTPS end-to-end, and sameSite=none requires secure=true (browsers will
# silently drop the cookie otherwise).
COOKIE_SECURE=true
COOKIE_SAMESITE=none
