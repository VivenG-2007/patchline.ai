# Copy to .env.local for local development (Next.js loads .env.local
# automatically and it's gitignored). NEXT_PUBLIC_* vars are inlined into
# the browser bundle at build time — never put secrets in them.

NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000
NEXT_PUBLIC_MAIN_API_URL=http://localhost:5001

# Server-only (read by middleware.ts on the edge, not sent to the browser).
# Must be the SAME public key + issuer/audience as auth-service's signing
# config, or middleware will treat every valid session as logged out.
JWT_PUBLIC_KEY_BASE64=paste_public_key_from_generate-keys_here
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchline

# middleware.ts also calls NEXT_PUBLIC_AUTH_API_URL directly (server-side)
# to silently refresh an expired access_token using the refresh_token
# cookie before falling back to redirecting to /login — no separate var
# needed for that, it reuses the URL above. If auth-service isn't reachable
# from wherever this app is deployed (e.g. different network/VPC), that
# refresh attempt will time out after 5s and fall through to /login.
